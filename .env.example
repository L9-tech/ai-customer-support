# Offline demo uses SQLite and does not contact mail, PostgreSQL or OpenAI.
APP_MODE=demo
# Set false in live mode to pause provider calls while keeping mailbox ingestion active.
AI_ENABLED=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Set a private strong password before APP_MODE=live.
DATABASE_URL=
OPENAI_API_KEY=
CLASSIFIER_MODEL=openai:gpt-6-luna
AGENT_MODEL=openai:gpt-6.1-sol
EMAIL_USERNAME=
EMAIL_PASSWORD=
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_FOLDER=INBOX
IMAP_SENT_FOLDER=Sent
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
POLL_INTERVAL_SECONDS=60
POLL_BATCH_SIZE=25
ENABLE_SENDING=false
